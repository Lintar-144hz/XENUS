#include <xenus/ucore.h>
#include "xenus.h"
#include "auth_screen.h"

#include <X11/keysym.h>
#include <X11/Xutil.h>
#include <string.h>
#include <stdio.h>

#define AUTH_INPUT_MAX 256

static Window auth_window;
static GC auth_gc;
static int active;
static int keyboard_grabbed;
static int pointer_grabbed;
static char password[AUTH_INPUT_MAX];
static size_t password_len;
static char message[128] = "Masukkan password untuk melanjutkan";

static void wipe_input(void)
{
    volatile char *p = password;

    for (size_t i = 0; i < sizeof(password); i++)
        p[i] = 0;

    password_len = 0;
}

static void rounded_rect(int x, int y, int w, int h, int r,
                         unsigned long color, int filled)
{
    if (w <= 0 || h <= 0)
        return;

    if (r * 2 > w) r = w / 2;
    if (r * 2 > h) r = h / 2;

    XSetForeground(sc.dpy, auth_gc, color);

    if (filled) {
        XFillRectangle(sc.dpy, auth_window, auth_gc,
                       x + r, y, w - 2 * r, h);
        XFillRectangle(sc.dpy, auth_window, auth_gc,
                       x, y + r, w, h - 2 * r);

        XFillArc(sc.dpy, auth_window, auth_gc,
                 x, y, 2 * r, 2 * r, 0, 360 * 64);
        XFillArc(sc.dpy, auth_window, auth_gc,
                 x + w - 2 * r, y, 2 * r, 2 * r, 0, 360 * 64);
        XFillArc(sc.dpy, auth_window, auth_gc,
                 x, y + h - 2 * r, 2 * r, 2 * r, 0, 360 * 64);
        XFillArc(sc.dpy, auth_window, auth_gc,
                 x + w - 2 * r, y + h - 2 * r,
                 2 * r, 2 * r, 0, 360 * 64);
    } else {
        XDrawLine(sc.dpy, auth_window, auth_gc,
                  x + r, y, x + w - r, y);
        XDrawLine(sc.dpy, auth_window, auth_gc,
                  x + r, y + h, x + w - r, y + h);
        XDrawLine(sc.dpy, auth_window, auth_gc,
                  x, y + r, x, y + h - r);
        XDrawLine(sc.dpy, auth_window, auth_gc,
                  x + w, y + r, x + w, y + h - r);

        XDrawArc(sc.dpy, auth_window, auth_gc,
                 x, y, 2 * r, 2 * r, 90 * 64, 90 * 64);
        XDrawArc(sc.dpy, auth_window, auth_gc,
                 x + w - 2 * r, y, 2 * r, 2 * r,
                 0, 90 * 64);
        XDrawArc(sc.dpy, auth_window, auth_gc,
                 x, y + h - 2 * r, 2 * r, 2 * r,
                 180 * 64, 90 * 64);
        XDrawArc(sc.dpy, auth_window, auth_gc,
                 x + w - 2 * r, y + h - 2 * r,
                 2 * r, 2 * r, 270 * 64, 90 * 64);
    }
}

static void draw_centered(const char *text, int y,
                          XFontStruct *font, unsigned long color)
{
    if (!text || !font)
        return;

    int width = XTextWidth(font, text, (int)strlen(text));

    XSetForeground(sc.dpy, auth_gc, color);
    XSetFont(sc.dpy, auth_gc, font->fid);

    XDrawString(sc.dpy, auth_window, auth_gc,
                (sc.sw - width) / 2, y,
                text, (int)strlen(text));
}

void auth_screen_draw(void)
{
    if (!active || !auth_window)
        return;

    Display *dpy = sc.dpy;

    unsigned long bg = cfg.col_background;
    unsigned long fg = cfg.col_menu_fg;
    unsigned long accent = cfg.col_menu_sel;
    unsigned long muted = cfg.col_border_unfocus;
    unsigned long panel = cfg.col_menu_bg;

    int cx = sc.sw / 2;
    int cy = sc.sh / 2;

    int card_w = sc.sw - 32;
    if (card_w > 420)
        card_w = 420;
    if (card_w < 240)
        card_w = sc.sw - 16;

    int card_h = 330;
    int card_x = cx - card_w / 2;
    int card_y = cy - card_h / 2;

    XSetForeground(dpy, auth_gc, bg);
    XFillRectangle(dpy, auth_window, auth_gc,
                   0, 0, (unsigned int)sc.sw,
                   (unsigned int)sc.sh);

    /* Main login panel */
    rounded_rect(card_x, card_y, card_w, card_h,
                 16, panel, 1);

    rounded_rect(card_x, card_y, card_w, card_h,
                 16, muted, 0);

    /* Accent detail */
    rounded_rect(cx - 24, card_y + 22, 48, 3,
                 2, accent, 1);

    /* Branding */
    draw_centered("XENUS", card_y + 76,
                  sc.font_bold, fg);

    draw_centered("YOUR DESKTOP, YOUR SPACE",
                  card_y + 101, sc.font, muted);

    /* Status */
    draw_centered(message, card_y + 137,
                  sc.font, fg);

    /* Password field */
    int field_w = card_w - 48;
    if (field_w < 180)
        field_w = card_w - 24;

    int field_x = cx - field_w / 2;
    int field_y = card_y + 153;

    rounded_rect(field_x, field_y, field_w, 46,
                 8, bg, 1);

    rounded_rect(field_x, field_y, field_w, 46,
                 8, accent, 0);

    char masked[AUTH_INPUT_MAX];
    size_t n = password_len;

    if (n >= sizeof(masked))
        n = sizeof(masked) - 1;

    memset(masked, '*', n);
    masked[n] = '\0';

    if (n > 0) {
        XSetForeground(dpy, auth_gc, fg);
        XSetFont(dpy, auth_gc, sc.font->fid);

        XDrawString(dpy, auth_window, auth_gc,
                    field_x + 16, field_y + 29,
                    masked, (int)n);
    } else {
        const char *placeholder = "Password XENUS";

        XSetForeground(dpy, auth_gc, muted);
        XSetFont(dpy, auth_gc, sc.font->fid);

        XDrawString(dpy, auth_window, auth_gc,
                    field_x + 16, field_y + 29,
                    placeholder, (int)strlen(placeholder));
    }

    /* Unlock button */
    int button_w = field_w;
    int button_y = card_y + 221;

    rounded_rect(cx - button_w / 2, button_y,
                 button_w, 42, 8, accent, 1);

    draw_centered("UNLOCK XENUS",
                  button_y + 27, sc.font_bold, bg);

    /* Footer */
    draw_centered("ENTER TO CONTINUE",
                  card_y + 291, sc.font, muted);

    XFlush(dpy);
}

int auth_screen_open(void)
{
    if (active)
        return 0;

    XSetWindowAttributes attr;
    memset(&attr, 0, sizeof(attr));

    attr.override_redirect = True;
    attr.background_pixel = cfg.col_background;
    attr.event_mask = ExposureMask | KeyPressMask |
                      ButtonPressMask | StructureNotifyMask;

    auth_window = XCreateWindow(
        sc.dpy, sc.root,
        0, 0, (unsigned int)sc.sw, (unsigned int)sc.sh,
        0, CopyFromParent, InputOutput, CopyFromParent,
        CWOverrideRedirect | CWBackPixel | CWEventMask,
        &attr
    );

    if (!auth_window)
        return -1;

    auth_gc = XCreateGC(sc.dpy, auth_window, 0, NULL);
    if (!auth_gc) {
        XDestroyWindow(sc.dpy, auth_window);
        auth_window = None;
        return -1;
    }

    wipe_input();
    snprintf(message, sizeof(message),
             "Masukkan password untuk melanjutkan");

    active = 1;

    XMapRaised(sc.dpy, auth_window);
    XSetInputFocus(sc.dpy, auth_window, RevertToParent, CurrentTime);
    XSync(sc.dpy, False);

    int grab = XGrabKeyboard(
        sc.dpy, auth_window, True,
        GrabModeAsync, GrabModeAsync, CurrentTime
    );

    if (grab != GrabSuccess) {
        auth_screen_close();
        return -1;
    }
    keyboard_grabbed = 1;

    grab = XGrabPointer(
        sc.dpy, auth_window, True,
        ButtonPressMask | ButtonReleaseMask | PointerMotionMask,
        GrabModeAsync, GrabModeAsync,
        auth_window, None, CurrentTime
    );

    if (grab != GrabSuccess) {
        auth_screen_close();
        return -1;
    }
    pointer_grabbed = 1;

    auth_screen_draw();
    XFlush(sc.dpy);
    return 0;
}

void auth_screen_close(void)
{
    if (keyboard_grabbed)
        XUngrabKeyboard(sc.dpy, CurrentTime);

    if (pointer_grabbed)
        XUngrabPointer(sc.dpy, CurrentTime);

    keyboard_grabbed = 0;
    pointer_grabbed = 0;

    wipe_input();
    active = 0;

    if (auth_gc)
        XFreeGC(sc.dpy, auth_gc);

    if (auth_window)
        XDestroyWindow(sc.dpy, auth_window);

    auth_gc = NULL;
    auth_window = None;

    XFlush(sc.dpy);
}

int auth_screen_active(void)
{
    return active;
}

int auth_screen_handle_event(XEvent *ev)
{
    if (!active || !ev)
        return 0;

    if (ev->type == Expose) {
        if (ev->xexpose.window == auth_window)
            auth_screen_draw();
        return 1;
    }

    if (ev->type == KeyPress) {
        KeySym key;
        char input[32];

        int len = XLookupString(&ev->xkey, input,
                                sizeof(input), &key, NULL);

        if (key == XK_BackSpace) {
            if (password_len > 0)
                password[--password_len] = '\0';
        } else if (key == XK_Return || key == XK_KP_Enter) {
            password[password_len] = '\0';

            if (xenus_auth_verify(password) == 0) {
                auth_screen_close();
                return 1;
            }

            snprintf(message, sizeof(message),
                     "Password salah. Silakan coba lagi.");
            wipe_input();
        } else if (key == XK_Escape) {
            /* Login tidak dapat dibatalkan dengan Escape. */
        } else if (len > 0 &&
                   password_len + (size_t)len < sizeof(password) - 1) {
            for (int i = 0; i < len; i++) {
                unsigned char c = (unsigned char)input[i];

                if (c >= 32 && c <= 126)
                    password[password_len++] = (char)c;
            }
            password[password_len] = '\0';
        }

        auth_screen_draw();
        return 1;
    }

    if (ev->type == ButtonPress)
        return 1;

    return 1;
}
